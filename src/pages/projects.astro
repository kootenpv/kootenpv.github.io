---
import BaseLayout from "~/layouts/BaseLayout.astro";

const projects = [
  {
    name: "whereami",
    href: "https://github.com/kootenpv/whereami",
    img: "/assets/whereami_predict.png",
    desc: "Predict where you are indoors using machine learning.",
  },
  {
    name: "shrynk",
    href: "https://github.com/kootenpv/shrynk",
    img: "https://uvreatio.sirv.com/Images/Shrynk.png",
    desc: "Using machine learning to choose how to compress files.",
  },
  {
    name: "yagmail",
    href: "https://github.com/kootenpv/yagmail",
    img: "/img/projects/yagmail.png",
    desc: "Send emails in Python without the SMTP / MIME boilerplate.",
  },
  {
    name: "neural_complete",
    href: "https://github.com/kootenpv/neural_complete",
    img: "/img/projects/neural_complete-poster.jpg",
    video: "/img/projects/neural_complete",
    desc: "A neural network trained to autocomplete Python source code.",
  },
  {
    name: "textsearch",
    href: "https://github.com/kootenpv/textsearch",
    img: "/img/projects/textsearch.png",
    desc: "Fast and configurable multi-string search for NLP.",
  },
  {
    name: "nostalgia",
    href: "https://github.com/nostalgia-dev/nostalgia",
    img: "/img/projects/nostalgia.png",
    desc: "Utilize your personal data like Google!",
  },
  {
    name: "sky",
    href: "https://github.com/kootenpv/sky",
    img: "/img/projects/sky.png",
    desc: "A web crawler designed to extract data from many sites.",
  },
  {
    name: "sysdm",
    href: "https://github.com/kootenpv/sysdm",
    img: "/img/projects/sysdm-poster.jpg",
    video: "/img/projects/sysdm",
    desc: "A friendly TUI for managing systemd services.",
  },
  {
    name: "gittyleaks",
    href: "https://github.com/kootenpv/gittyleaks",
    img: "/img/projects/gittyleaks.png",
    desc: "Detect leaked secrets and credentials in git history.",
  },
  {
    name: "brightml",
    href: "https://github.com/kootenpv/brightml",
    img: "/img/projects/brightml.png",
    desc: "Automatic laptop screen brightness using machine learning.",
  },
];
---

<BaseLayout title="Projects" description="Open-source projects by Pascal van Kooten">
  <h1 class="text-3xl font-bold">Projects</h1>

  <section class="slop-trace" aria-label="Project index stack trace">
    <div class="slop-trace__chrome">
      <span></span>
      <span></span>
      <span></span>
      <strong>index-d</strong>
    </div>
    <pre class="slop-trace__body"><code><span class="slop-trace__muted">Traceback (most recent call last):</span>
  File "index-d/curation.py", line 138, in reconcile_signal
    from index_d_rust import rank_projects
  File "<maturin>", line 17, in load_extension
    dlopen("wheel/index_d_rust.cpython-412-x86_64-linux.so")
  <span class="slop-trace__muted">note:</span> ABI tag cpython-412 (python4 not yet ABI-stable)
  File "index-d/curation.py", line 152, in preserve_signal
    rank_projects(projects, synthetic_noise, strict=True)
  <span class="slop-trace__muted">rust backtrace:</span>
    0: index_d::rank::score_catalog
    1: pyo3::impl_::trampoline::trampoline
    2: cpython::ceval::call_function
<span class="slop-trace__error">IndexDriftError:</span> Index fallen behind <span id="slop-project-count" class="slop-trace__count">1381</span> AI slop projects
<span class="slop-trace__muted">recovery:</span> prioritizing artifacts with working code paths</code></pre>
  </section>

  <p class="mt-6 text-muted">
    Some of my old open-source work. Visit
    <a href="https://github.com/kootenpv/" rel="noopener">my GitHub</a>
    for more. More projects are coming soon.
  </p>

  <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      projects.map((p) => (
        <li class="border border-border rounded-lg p-4 bg-card hover:border-accent transition-colors">
          <a href={p.href} class="flex items-center gap-4 no-underline" rel="noopener">
            {p.video ? (
              <video
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                poster={p.img}
                class="w-20 h-20 object-contain rounded"
                aria-label={p.name}
              >
                <source src={`${p.video}.webm`} type="video/webm" />
                <source src={`${p.video}.mp4`} type="video/mp4" />
              </video>
            ) : (
              <img
                src={p.img}
                alt={p.name}
                loading="lazy"
                class="w-20 h-20 object-contain rounded"
              />
            )}
            <div>
              <div class="font-semibold text-fg">{p.name}</div>
              <div class="text-sm text-muted mt-1">{p.desc}</div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-10 text-xl font-semibold">Presentations</h2>
  <ul class="mt-2 list-disc list-inside text-fg">
    <li>
      SQL Injection — processed 1.8 billion links searching for vulnerabilities.
    </li>
  </ul>

  <script is:inline>
    (function () {
      const el = document.getElementById("slop-project-count");
      if (!el) return;
      let count = 1381;
      setInterval(() => {
        count += 1;
        el.textContent = String(count);
      }, 1000);
    })();
  </script>

  <style>
    .slop-trace {
      position: relative;
      margin-top: 1.75rem;
      border: 1px solid rgb(var(--c-accent) / 0.55);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgb(var(--c-accent) / 0.12), transparent 34%),
        linear-gradient(180deg, rgb(0 0 0 / 0.86), rgb(0 0 0 / 0.66));
      box-shadow:
        0 0 0 1px rgb(var(--c-accent) / 0.18),
        0 0 28px rgb(var(--tron-glow, 255 90 50) / 0.32),
        inset 0 0 28px rgb(var(--tron-glow, 255 90 50) / 0.07);
      overflow: hidden;
    }
    .slop-trace::before,
    .slop-trace::after {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      border: 1px solid rgb(var(--c-accent));
      box-shadow: 0 0 10px rgb(var(--tron-glow, 255 90 50) / 0.75);
      pointer-events: none;
    }
    .slop-trace::before {
      top: -1px;
      left: -1px;
      border-right: 0;
      border-bottom: 0;
    }
    .slop-trace::after {
      right: -1px;
      bottom: -1px;
      border-top: 0;
      border-left: 0;
    }
    .slop-trace__chrome {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 10px 12px;
      border-bottom: 1px solid rgb(var(--c-accent) / 0.35);
      background: rgb(var(--c-accent) / 0.08);
      color: rgb(var(--c-muted));
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .slop-trace__chrome span {
      width: 7px;
      height: 7px;
      border: 1px solid rgb(var(--c-accent));
      box-shadow: 0 0 8px rgb(var(--tron-glow, 255 90 50) / 0.75);
    }
    .slop-trace__chrome strong {
      margin-left: 6px;
      color: rgb(var(--c-accent));
      font-weight: 600;
      text-shadow: 0 0 8px rgb(var(--tron-glow, 255 90 50) / 0.72);
    }
    .slop-trace__body {
      margin: 0;
      padding: 14px 16px 16px;
      overflow-x: auto;
      color: rgb(var(--c-fg));
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.65;
      text-shadow: 0 0 5px rgb(var(--tron-glow, 255 90 50) / 0.28);
    }
    .slop-trace__muted {
      color: rgb(var(--c-muted));
    }
    .slop-trace__error {
      color: #ff6b3a;
      text-shadow: 0 0 10px rgb(var(--tron-glow, 255 90 50) / 0.85);
    }
    .slop-trace__count {
      display: inline-block;
      min-width: 4ch;
      color: #ffd36a;
      font-weight: 700;
      text-shadow:
        0 0 8px rgb(var(--tron-glow, 255 90 50) / 0.9),
        0 0 16px rgb(255 211 106 / 0.45);
    }
    @media (max-width: 640px) {
      .slop-trace__body {
        padding: 12px;
        font-size: 10px;
        line-height: 1.55;
      }
      .slop-trace__chrome {
        font-size: 10px;
      }
    }
  </style>
</BaseLayout>
