  <script is:inline>
    (function () {
      // ---------- OS switcher with UA detection ----------
      function detectOS() {
        const ua = navigator.userAgent || "";
        const platform = navigator.platform || "";
        // iPadOS reports as Mac with touch — detect via maxTouchPoints
        const isIpad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
        if (/iPad|iPhone|iPod/.test(ua) || isIpad) return "ios";
        if (/Android/.test(ua)) return "android";
        if (/Win/i.test(platform) || /Windows/.test(ua)) return "windows";
        if (/Mac/i.test(platform) || /Mac OS X/.test(ua)) return "macos";
        if (/Linux|X11/.test(ua) || /Linux/i.test(platform)) return "linux";
        return "macos";
      }

      const switcher = document.querySelector(".os-switcher");
      const wrap = document.getElementById("terminal-wrap");
      if (switcher && wrap) {
        const buttons = switcher.querySelectorAll("button[data-os-set]");
        const hint = switcher.querySelector(".os-switcher-hint");
        const stored = (() => { try { return localStorage.getItem("cli-os"); } catch { return null; } })();
        wrap.dataset.os = stored || detectOS();
        if (hint && stored) hint.style.display = "none";
        const sync = () => {
          buttons.forEach((b) => {
            b.setAttribute("aria-pressed", String(b.dataset.osSet === wrap.dataset.os));
          });
        };
        buttons.forEach((b) => {
          b.addEventListener("click", () => {
            wrap.dataset.os = b.dataset.osSet;
            try { localStorage.setItem("cli-os", b.dataset.osSet); } catch {}
            const chatRoot = document.getElementById("chat-root");
            if (chatRoot) chatRoot.dataset.os = b.dataset.osSet;
            if (hint) hint.style.display = "none";
            sync();
            applyFlavor(b.dataset.osSet === "windows" ? "windows" : "unix");
            cwd = HOME;
            outputEl.innerHTML = "";
            appendWelcome();
            appendOutput("");
            setInput("");
            termEl.scrollTop = 0;
            focusTerm();
          });
        });
        sync();
      }

      // ---------- Local profile (built from browser-exposed signals; never leaves device) ----------
      let highEntropyUA = null;
      if (navigator.userAgentData && typeof navigator.userAgentData.getHighEntropyValues === "function") {
        navigator.userAgentData
          .getHighEntropyValues([
            "platformVersion",
            "architecture",
            "bitness",
            "model",
            "fullVersionList",
            "wow64",
          ])
          .then((d) => { highEntropyUA = d; })
          .catch(() => {});
      }

      function osLabel(id) {
        return ({ macos: "macOS", windows: "Windows", linux: "Linux", ios: "iOS", android: "Android" })[id] || id;
      }
      function pad(k, w) { return (k + " ".repeat(w)).slice(0, w); }
      function row(k, v) { return "  " + pad(k, 16) + " : " + (v == null || v === "" ? "n/a" : v); }
      function fmtBytes(n) {
        if (n == null) return "n/a";
        return n + " GB";
      }
      function safe(fn, fallback) {
        try { return fn(); } catch { return fallback; }
      }

      function buildProfile() {
        const nav = navigator;
        const ua = nav.userAgent || "";
        const uad = nav.userAgentData;
        const conn = nav.connection || nav.mozConnection || nav.webkitConnection || null;
        const tz = safe(() => Intl.DateTimeFormat().resolvedOptions().timeZone, "n/a");
        const locale = safe(() => Intl.DateTimeFormat().resolvedOptions().locale, "n/a");
        const langs = (nav.languages && nav.languages.join(", ")) || nav.language || "n/a";
        const dnt = nav.doNotTrack === "1" || window.doNotTrack === "1" ? "yes" :
                    nav.doNotTrack === "0" ? "no" : "unspecified";
        const detected = osLabel(detectOS());
        const brands = uad && uad.brands ? uad.brands.map((b) => b.brand + " " + b.version).join(", ") : null;
        const fullVer = highEntropyUA && highEntropyUA.fullVersionList
          ? highEntropyUA.fullVersionList.map((b) => b.brand + " " + b.version).join(", ")
          : null;
        const now = new Date();
        const localTime = safe(
          () => now.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "long" }),
          now.toString()
        );

        const lines = [];
        if (isMobileMode()) {
          lines.push("┌─ SYSTEM PROFILE ───────────");
          lines.push("│ Local browser-only report.");
          lines.push("│ No cookies or network calls.");
          lines.push("└────────────────────────────");
        } else {
          lines.push("┌─ SYSTEM PROFILE ──────────────────────────────────────────────");
          lines.push("│ Built locally from browser APIs. Nothing here is sent anywhere.");
          lines.push("│ No cookies, no tracking, no network calls. (GDPR-friendly.)");
          lines.push("└───────────────────────────────────────────────────────────────");
        }
        lines.push("");

        lines.push("[ Operating System ]");
        lines.push(row("Detected OS", detected));
        lines.push(row("Platform", nav.platform || "n/a"));
        if (uad && uad.platform) lines.push(row("UA-CH Platform", uad.platform));
        if (highEntropyUA && highEntropyUA.platformVersion) lines.push(row("OS Version", highEntropyUA.platformVersion));
        if (highEntropyUA && highEntropyUA.architecture) {
          const arch = highEntropyUA.architecture + (highEntropyUA.bitness ? " / " + highEntropyUA.bitness + "-bit" : "");
          lines.push(row("Architecture", arch));
        }
        if (highEntropyUA && highEntropyUA.model) lines.push(row("Device Model", highEntropyUA.model || "n/a"));
        lines.push("");

        lines.push("[ Browser ]");
        lines.push(row("User Agent", ua));
        if (brands) lines.push(row("UA Brands", brands));
        if (fullVer) lines.push(row("UA Versions", fullVer));
        if (uad) lines.push(row("Mobile (UA-CH)", String(!!uad.mobile)));
        lines.push(row("Touch Points", nav.maxTouchPoints != null ? nav.maxTouchPoints : "n/a"));
        lines.push(row("Vendor", nav.vendor || "n/a"));
        lines.push("");

        lines.push("[ Locale & Time ]");
        lines.push(row("Language", nav.language || "n/a"));
        lines.push(row("All Languages", langs));
        lines.push(row("Locale", locale));
        lines.push(row("Time Zone", tz));
        lines.push(row("Local Time", localTime));
        lines.push("");

        lines.push("[ Display ]");
        lines.push(row("Screen", screen.width + " x " + screen.height + " px"));
        lines.push(row("Available", screen.availWidth + " x " + screen.availHeight + " px"));
        lines.push(row("Viewport", window.innerWidth + " x " + window.innerHeight + " px"));
        lines.push(row("Pixel Ratio", String(window.devicePixelRatio || 1)));
        lines.push(row("Color Depth", (screen.colorDepth || "n/a") + " bit"));
        lines.push(row("Orientation", safe(() => screen.orientation && screen.orientation.type, "n/a")));
        lines.push("");

        lines.push("[ Hardware ]");
