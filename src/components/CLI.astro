      // The hidden <input> is the source of truth for the current line text;
      // the visible span just mirrors it. Programmatic .value assignments do
      // not fire the `input` event, so this mirror is one-way only.
      function getInput() { return mobileInputEl.value; }
      function setInput(s) {
        mobileInputEl.value = s;
