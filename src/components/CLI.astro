      function flavorCfg() { return COMMANDS_DATA[flavor]; }
      function setClaudeMode(on) {
        claudeMode = !!on;
        // Entering claude exits codex (mutually exclusive REPLs).
        if (claudeMode) codexMode = false;
        // Driving CSS from a data attr on the terminal element so the box
        // around the live input only shows while the REPL is active.
