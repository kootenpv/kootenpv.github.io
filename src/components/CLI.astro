        },
        codex() {
          setCodexMode(true);
          // Static Unicode-box banner, mirroring the OpenAI Codex CLI chrome.
          // Inner width is 50 chars so the right border lines up with all rows.
          const innerWidth = 50;
          const dirShown = shortPath(cwd);
          const padRight = (s, w) => {
            const visible = s.length;
            return s + " ".repeat(Math.max(0, w - visible));
          };
          const top = "╭" + "─".repeat(innerWidth) + "╮";
          const bot = "╰" + "─".repeat(innerWidth) + "╯";
          const blank = "│" + " ".repeat(innerWidth) + "│";
          const titleInner = " >_ OpenAI Codex (v0.128.0)";
          const titleRow = "│" + padRight(titleInner, innerWidth) + "│";
          const modelInner = " model:     gpt-6.6 max-tokens   /model to change";
          const modelRow = "│" + padRight(modelInner, innerWidth) + "│";
          const dirInner = " directory: " + dirShown;
          const dirRow = "│" + padRight(dirInner, innerWidth) + "│";
          const esc = escapeHTML;
          const frame = (s) => '<span class="codex-banner-frame">' + esc(s) + "</span>";
          const html =
            '<div class="codex-banner">' +
              frame(top) + "\n" +
              frame(titleRow) + "\n" +
              frame(blank) + "\n" +
              frame(modelRow) + "\n" +
              frame(dirRow) + "\n" +
              frame(bot) +
            '</div>' +
            '<div class="codex-banner-tip">' +
              "  Tip: quality slop over quantity slop" +
            '</div>';
          return { html: html };
        },
        history() { return history.map((h, i) => "  " + (i + 1) + "  " + h).join("\n"); },
        list(args) {
          const { opts, positional } = parseArgs(args);
          const target = positional[0] || cwd;
          const node = resolve(target);
          if (!node) return { err: "ls: " + target + ": No such file or directory" };
          if (node.type === "file") {
            return { html: '<span class="term-file">' + escapeHTML(target) + "</span>" };
          }
          let names = Object.keys(node.children).filter((n) => {
            return flavorAllows(node.children[n], flavor);
          });
          if (!opts.a) names = names.filter((n) => !n.startsWith("."));
          // sort: alpha by default; -t = mtime desc; -r reverses final order
          names.sort((a, b) => a.localeCompare(b));
          if (opts.t) {
            names.sort((a, b) => {
              const ma = node.children[a].mtime ? node.children[a].mtime.getTime() : 0;
              const mb = node.children[b].mtime ? node.children[b].mtime.getTime() : 0;
              return mb - ma;
            });
          }
          if (opts.r) names.reverse();
          // Always classify dirs with a trailing `/` (per `alias ls='ls -F'`
          // in ~/.bashrc). Skip on Windows where the convention is `\`.
          const classify = (c, n) =>
            c.type === "dir" && flavor !== "windows" ? n + "/" : n;
          const listedAbs = normalize(target);
          const renderLsName = (c, n) => {
            const cls = c.type === "dir" ? "term-dir" : "term-file";
            const label = escapeHTML(classify(c, n));
            if (c.type !== "file" || !isMobileMode()) {
              return '<span class="' + cls + '">' + label + "</span>";
            }
            const catArg = relativeToCwd(joinPath(listedAbs, n));
            const command = n === "claude"
              ? "claude"
              : n === "codex"
                ? "codex"
                : (flavor === "windows" ? "type " : "cat ") + shellQuote(catArg);
            return commandButtonHTML(classify(c, n), command, cls);
          };
          if (opts.l) {
            const lines = names.map((n) => {
              const c = node.children[n];
              const t = c.type === "dir" ? "d" : "-";
              const rawSize = c.type === "file" ? fileSize(c) : 4096;
              const size = opts.h ? humanSize(rawSize) : String(rawSize);
              const when = fmtMtime(c.mtime || NOW);
              return t + "rw-r--r--  1 guest guest " + size.padStart(6) +
                " " + when +
                " " + renderLsName(c, n);
            });
            return { html: lines.join("<br>") };
          }
          const parts = names.map((n) => {
            const c = node.children[n];
            return renderLsName(c, n);
          });
          return { html: parts.join("  ") };
        },
        chdir(args) {
          // Windows `cd` with no args prints cwd; Unix `cd` goes home.
          if (args.length === 0) {
            if (flavor === "windows") return cwd;
            cwd = HOME;
            renderPrompt();
            return null;
          }
          const target = args[0];
          const dest = target === "-" ? HOME : target;
          const abs = normalize(dest);
          const node = resolve(abs);
          if (!node) return { err: "cd: " + target + ": No such file or directory" };
          if (node.type !== "dir") return { err: "cd: " + target + ": Not a directory" };
          cwd = abs;
          renderPrompt();
          return null;
        },
        cat(args) {
          if (args.length === 0) return { err: "cat: missing file operand" };
          // Resolve once so we know whether to render html (any blog post) or text.
          const resolved = [];
          for (const a of args) {
            const node = resolve(a);
            if (!node) return { err: "cat: " + a + ": No such file or directory" };
            if (node.type !== "file") return { err: "cat: " + a + ": Is a directory" };
            resolved.push({ a, node });
          }
          const anyUrl = resolved.some((r) => r.node.url);
          if (anyUrl) {
            const PREVIEW = 10;
            const blocks = resolved.map(({ a, node }) => {
              const text = read(node);
              const lines = text.split("\n");
              const head = lines.slice(0, PREVIEW).join("\n");
              const remaining = Math.max(0, lines.length - PREVIEW);
              let block = '<pre class="term-cat-head">' + escapeHTML(head) + "</pre>";
              if (node.url) {
                const link =
                  '<a class="term-link" href="' + escapeHTML(node.url) + '">' +
                  escapeHTML(node.url) + "</a>";
                const tail = remaining > 0
                  ? "… " + remaining + " more line" + (remaining === 1 ? "" : "s") +
                    " — read in full: " + link
                  : "read in full: " + link;
                block += '<div class="term-cat-more">' + tail + "</div>";
              } else if (resolved.length > 1) {
                // Mixed bag: keep file headers stable so output stays parseable.
                block = '<div class="term-file">==&gt; ' + escapeHTML(a) + " &lt;==</div>" + block;
              }
              return block;
            });
            return { html: blocks.join("") };
          }
          const out = [];
          for (const { a, node } of resolved) {
            if (node.binary) {
              // Flash the gibberish briefly, then it disappears — like a
              // terminal that briefly chokes on binary then recovers.
              const div = document.createElement("div");
              div.className = "term-out-line";
              div.textContent = read(node);
              outputEl.appendChild(div);
              termEl.scrollTop = termEl.scrollHeight;
              setTimeout(() => { div.remove(); }, 1500);
            } else {
              out.push(read(node));
            }
          }
          return out.length ? out.join("\n") : null;
        },
      };

      function tokenize(line) {
        const tokens = [];
        const re = /"([^"]*)"|'([^']*)'|(\S+)/g;
        let m;
        while ((m = re.exec(line)) !== null) {
          tokens.push(m[1] !== undefined ? m[1] : m[2] !== undefined ? m[2] : m[3]);
        }
        return tokens;
      }
      function runClaudeLine(line) {
        if (line.startsWith("/")) {
          const cmd = line.slice(1).split(/\s+/)[0];
          if (cmd === "login") {
            const id = Math.floor(Math.random() * 9000000) + 1000000;
            const url = "https://claude.ai/oauth/authorize?code=true&client_id=" + id + "&joke=true";
            appendHTML(
              "login has been opened in browser at " +
              '<span class="claude-fake-link" style="text-decoration: underline; ' +
              'text-underline-offset: 2px; cursor: text;">' +
              escapeHTML(url) + "</span>"
            );
            appendHTML('<span style="color:#22c55e">Logged in as dario@anthropic.com</span>');
            appendHTML('<span style="color:#22c55e">Login successful. How can I help today?</span>');
            claudeLoggedIn = true;
            return;
          }
          if (cmd === "upgrade") {
            appendOutput(
              "All higher-tier plans are currently sold out. " +
              "You have been added to the waitlist for Claude Ultra Max 10000x.",
              "term-err"
            );
            // Pretend Ctrl+C: echo the claude prompt with `^C` on a new line,
            // then exit claude mode so the live prompt reverts to the shell.
            const ctrlCLine = document.createElement("div");
            ctrlCLine.className = "term-out-line";
            const ps = document.createElement("span");
            ps.className = "term-prompt";
            ps.style.color = "rgb(var(--c-accent))";
            ps.textContent = promptEl.textContent;
            const cs = document.createElement("span");
            cs.textContent = "^C";
            ctrlCLine.appendChild(ps);
            ctrlCLine.appendChild(cs);
            outputEl.appendChild(ctrlCLine);
            setClaudeMode(false);
            termEl.scrollTop = termEl.scrollHeight;
            return;
          }
          if (cmd === "exit" || cmd === "quit") {
            setClaudeMode(false);
            return;
          }
          if (cmd === "clear") { outputEl.innerHTML = ""; return; }
          if (cmd === "help") {
            appendOutput([
              "Slash commands:",
              "  /login    sign in",
              "  /upgrade  raise your usage tier",
              "  /clear    clear the screen",
              "  /exit     leave the Claude session",
            ].join("\n"));
            return;
          }
          appendOutput("Unknown slash command: /" + cmd, "term-err");
          return;
        }
        // Non-slash input: animate "Pascalling. .. ..." in place, then swap in the OAuth error.
        const div = document.createElement("div");
        div.className = "term-out-line";
        div.style.color = "#ff6b6b";
        const glyphs = ["✻", "✢", "·", "✽", "*"];
        const dots = [".", "..", "..."];
        let i = 0;
        let g = 0;
        div.textContent = glyphs[g] + " Pascalling.";
        outputEl.appendChild(div);
        termEl.scrollTop = termEl.scrollHeight;
        const interval = setInterval(() => {
          i = (i + 1) % dots.length;
          g = (g + 1) % glyphs.length;
          div.textContent = glyphs[g] + " Pascalling" + dots[i];
        }, 350);
        setTimeout(() => {
          clearInterval(interval);
          div.style.color = "#ff6b6b";
          if (!claudeLoggedIn) {
            div.textContent = "Please run ";
            const link = document.createElement("span");
            link.className = "claude-fake-link claude-login-link";
            link.style.cursor = "pointer";
            link.style.textDecoration = "underline";
            link.style.textUnderlineOffset = "2px";
            link.style.padding = "0 2px";
            link.textContent = "/login";
            link.addEventListener("click", (e) => {
              e.stopPropagation();
              if (!claudeMode) setClaudeMode(true);
              simulateClaudeEntry("/login");
            });
            div.appendChild(link);
            div.appendChild(document.createTextNode(
              ' · API Error: 401 {"type":"error","error":' +
              '{"type":"authentication_error","message":"OAuth token has expired"}}'
            ));
          } else {
            div.textContent =
              'API Error: 429 {"type":"error","error":' +
              '{"type":"rate_limit_error","message":"Usage limit reached on ' +
              'Claude Ultra Max 1000x. Resets in 4h 59m."}}';
            const ask = document.createElement("div");
            ask.className = "term-out-line";
            ask.style.color = "#a0a0a0";
            ask.innerHTML =
              "Subscribe to a higher tier? Run " +
              commandButtonHTML("/upgrade", "/upgrade", "claude-fake-link");
            outputEl.appendChild(ask);
          }
          termEl.scrollTop = termEl.scrollHeight;
        }, 2400);
      }

      function runCodexLine(line) {
        if (line.startsWith("/")) {
          const cmd = line.slice(1).split(/\s+/)[0];
          if (cmd === "exit" || cmd === "quit") {
            setCodexMode(false);
            return;
          }
          if (cmd === "clear") { outputEl.innerHTML = ""; return; }
          if (cmd === "help") {
            appendOutput([
              "Slash commands:",
              "  /clear    clear the screen",
              "  /model    pick the model",
              "  /exit     leave the Codex session",
            ].join("\n"));
            return;
          }
          if (cmd === "model") {
            // Only one picker can be open at a time.
            if (modelPickerEl) closeModelPicker(false);
            const wrap = document.createElement("div");
            wrap.className = "term-out-line";
            const picker = document.createElement("div");
            picker.className = "codex-model-picker";
            picker.setAttribute("data-active", "true");
            const title = document.createElement("div");
            title.className = "codex-model-picker-title";
            title.textContent = "Select model  (Enter to confirm · Esc or q to cancel)";
            const opt = document.createElement("button");
            opt.type = "button";
            opt.className = "codex-model-option";
            opt.setAttribute("aria-pressed", "true");
            opt.innerHTML =
              '<span class="codex-model-option-marker">▸</span>' +
              '<span>gpt-6.6 max-tokens</span>' +
              '<span class="codex-model-option-badge">current</span>';
            opt.addEventListener("click", () => { closeModelPicker(true); });
            picker.appendChild(title);
            picker.appendChild(opt);
            wrap.appendChild(picker);
            outputEl.appendChild(wrap);
            modelPickerEl = picker;
            const t = document.getElementById("term");
            if (t) t.classList.add("model-picker-active");
            termEl.scrollTop = termEl.scrollHeight;
            return;
          }
          appendOutput("Unknown slash command: /" + cmd, "term-err");
          return;
        }
        // Non-slash input: spin briefly, then echo the user's line back with
        // a random goblin-flavored aside.
        const div = document.createElement("div");
        div.className = "term-out-line";
        div.style.color = "#a0a0a0";
        const spinnerFrames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
        let si = 0;
        div.textContent = spinnerFrames[0];
        outputEl.appendChild(div);
        termEl.scrollTop = termEl.scrollHeight;
        const spin = setInterval(() => {
          si = (si + 1) % spinnerFrames.length;
          div.textContent = spinnerFrames[si];
        }, 90);
        const goblinReplies = [
          "the goblin cave council gnaws on it now, three pebbles cast, raven nods, anyway 🧌",
          "mrrgh, that one tastes of moss and forgotten copper coins, the goblin elders would approve 🧌",
          "into the goblin hoard it goes, next to the cracked monocle and the spoon of regret, skrrk 🧌",
          "wrrgh, smells like dragon-aunt's pantry on a Tuesday — lore-juicy, slightly cursed, deeply goblin 🧌",
          "noted, scribbled on bark with charcoal, filed in the goblin archive under 'things the swamp told me' 🧌",
        ];
        setTimeout(() => {
          clearInterval(spin);
          div.style.color = "";
          const pick = goblinReplies[Math.floor(Math.random() * goblinReplies.length)];
          div.textContent = "Oh, you said " + line + ". " + pick;
          termEl.scrollTop = termEl.scrollHeight;
        }, 1000);
      }

      // Types text into the live input one character at a time, then
      // commits as if the user pressed Enter. Used by clickable /login.
      let typingSim = false;
      function simulateClaudeEntry(text) {
        if (typingSim) return;
        typingSim = true;
        setInput("");
        focusTerm();
        let idx = 0;
        const tick = () => {
          idx++;
          setInput(text.slice(0, idx));
          termEl.scrollTop = termEl.scrollHeight;
          if (idx < text.length) {
            setTimeout(tick, 70);
          } else {
            setTimeout(() => {
              typingSim = false;
              commitLine(text);
            }, 220);
          }
        };
        tick();
      }

      function runLine(raw) {
        const trimmed = raw.trim();
        if (!trimmed) return;
        history.push(trimmed);
        historyIdx = history.length;
        if (claudeMode) {
          runClaudeLine(trimmed);
          return;
        }
        if (codexMode) {
          runCodexLine(trimmed);
          return;
        }
        const first = trimmed.split(" ")[0];
        const expanded = activeAliases[first]
          ? activeAliases[first] + trimmed.slice(first.length)
          : trimmed;
        const tokens = tokenize(expanded);
        const cmd = tokens[0];
        const args = tokens.slice(1);
        const op = activeNames[cmd];
        const fn = op ? OPS[op] : null;
        if (!fn) {
          // Windows convention: typing `foo.exe` (or `foo`, with .exe inferred)
          // in a directory that contains it runs the file.
          if (flavor === "windows") {
            const dir = resolve(cwd);
            if (dir && dir.type === "dir") {
              const candidates = [cmd.toLowerCase(), cmd.toLowerCase() + ".exe"];
              for (const want of candidates) {
                const match = Object.keys(dir.children).find((n) => {
                  const c = dir.children[n];
                  return n.toLowerCase() === want
                    && c.type === "file"
                    && flavorAllows(c, flavor)
                    && typeof c.exec === "function";
                });
                if (match) {
                  const result = dir.children[match].exec(args);
                  if (typeof result === "string" && result !== "") appendOutput(result);
                  return;
                }
              }
            }
          }
          const tpl = flavorCfg().notFoundTemplate || "{cmd}: command not found. Type `help`.";
          appendOutput(tpl.replace("{cmd}", cmd), "term-err");
          return;
        }
        const result = fn(args);
        if (result == null) return;
        if (typeof result === "string") {
          if (result !== "") appendOutput(result);
        } else if (result.err) appendOutput(result.err, "term-err");
        else if (result.html != null) appendHTML(result.html);
      }
      function commitLine(raw) {
        const echoLine = document.createElement("div");
        echoLine.className = "term-out-line";
        const promptSpan = document.createElement("span");
        promptSpan.className = "term-prompt";
        promptSpan.style.color = "rgb(var(--c-accent))";
        promptSpan.textContent = promptEl.textContent;
        const cmdSpan = document.createElement("span");
        cmdSpan.textContent = raw;
        echoLine.appendChild(promptSpan);
        echoLine.appendChild(cmdSpan);
        outputEl.appendChild(echoLine);
        runLine(raw);
        setInput("");
        termEl.scrollTop = termEl.scrollHeight;
      }
      outputEl.addEventListener("click", (e) => {
        const btn = e.target.closest(".term-run-link[data-run-command]");
        if (!btn || !outputEl.contains(btn)) return;
        e.preventDefault();
        e.stopPropagation();
        const sel = window.getSelection();
        if (sel) sel.removeAllRanges();
        commitLine(btn.dataset.runCommand);
        if (isMobileMode()) blurTerm();
        else focusTerm();
      });
      function focusTerm() {
        // Focus the hidden input — that's what raises the on-screen keyboard
        // on mobile and is the actual target of typed text. The terminal div
        // remains tabbable for desktop accessibility, with a focus-redirect
        // listener below.
        mobileInputEl.focus({ preventScroll: true });
      }
      function blurTerm() {
        if (document.activeElement && typeof document.activeElement.blur === "function") {
          document.activeElement.blur();
        }
        mobileInputEl.blur();
        termEl.blur();
      }
      // Skip the focus redirect on mouse-initiated focus — otherwise the
      // synchronous re-focus during mousedown cancels the in-progress drag-
      // selection. The click handler below covers the mouse-click path.
      let mouseFocusing = false;
      termEl.addEventListener("mousedown", () => { mouseFocusing = true; });
      window.addEventListener("mouseup", () => { mouseFocusing = false; });
      termEl.addEventListener("focus", () => {
        if (mouseFocusing) return;
        mobileInputEl.focus({ preventScroll: true });
      });

      termEl.addEventListener("click", () => {
        const sel = window.getSelection();
        if (sel && sel.toString().length > 0) return;
        focusTerm();
      });

      // Keys the terminal claims while focused. Captured at the window level so
      // page-level plugins (e.g., extensions that hijack Backspace) can't eat them.
      const OWNED_KEYS = new Set([
        "Backspace", "Enter", "Tab",
        "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight",
        "Home", "End",
      ]);
      function isTermFocused() {
        return document.activeElement === termEl
          || document.activeElement === mobileInputEl
          || termEl.contains(document.activeElement);
      }
      function isOurKey(e) {
        if (e.ctrlKey || e.metaKey || e.altKey) return false;
        if (OWNED_KEYS.has(e.key)) return true;
        return e.key && e.key.length === 1; // printable
      }
      const termKeydown = (e) => {
        if (!isTermFocused()) return;
        // Beat any page-level / extension listener that wants to eat these keys
        // (Backspace -> back nav, Tab -> focus jump, etc.). preventDefault alone
        // is not enough if a plugin is also listening; we also stop other
        // capture-phase listeners on this same dispatch.
        if (isOurKey(e)) e.stopImmediatePropagation();

        // Model picker captures keys while open: Enter confirms; Esc or q cancel.
        if (isModelPickerOpen() && !e.ctrlKey && !e.metaKey && !e.altKey) {
          if (e.key === "Enter") { e.preventDefault(); closeModelPicker(true); return; }
          if (e.key === "Escape" || e.key === "q" || e.key === "Q") {
            e.preventDefault();
            closeModelPicker(false);
            return;
          }
          // Disable arrow keys (no history nav / cursor movement) while picking.
          if (
            e.key === "ArrowUp" || e.key === "ArrowDown" ||
            e.key === "ArrowLeft" || e.key === "ArrowRight"
          ) { e.preventDefault(); return; }
          // Swallow other printable keys while the picker has focus so they
          // don't leak into the prompt input.
          if (e.key && e.key.length === 1) { e.preventDefault(); return; }
        }

        if (e.ctrlKey || e.metaKey) {
          if (e.key === "l") { e.preventDefault(); outputEl.innerHTML = ""; return; }
          if (e.key === "c") {
            const sel = window.getSelection();
            if (sel && sel.toString().length > 0) return;
            e.preventDefault();
            if (claudeMode) {
              setInput("");
              setClaudeMode(false);
              termEl.scrollTop = termEl.scrollHeight;
              return;
            }
            if (codexMode) {
              setInput("");
              setCodexMode(false);
              termEl.scrollTop = termEl.scrollHeight;
              return;
            }
            const echoLine = document.createElement("div");
            echoLine.className = "term-out-line";
            const ps = document.createElement("span");
            ps.className = "term-prompt";
            ps.style.color = "rgb(var(--c-accent))";
            ps.textContent = promptEl.textContent;
            const cs = document.createElement("span");
            cs.textContent = getInput() + "^C";
            echoLine.appendChild(ps);
            echoLine.appendChild(cs);
            outputEl.appendChild(echoLine);
            setInput("");
            termEl.scrollTop = termEl.scrollHeight;
            return;
          }
          if (e.key === "d" && claudeMode) {
            e.preventDefault();
            setInput("");
            setClaudeMode(false);
            termEl.scrollTop = termEl.scrollHeight;
            return;
          }
          if (e.key === "d" && codexMode) {
            e.preventDefault();
            setInput("");
            setCodexMode(false);
            termEl.scrollTop = termEl.scrollHeight;
            return;
          }
          return;
        }
        if (e.key === "Enter") { e.preventDefault(); commitLine(getInput()); return; }
        // Backspace and printable keys are handled natively by the hidden
        // <input>; its `input` listener mirrors the new value into the span.
        if (e.key === "ArrowUp") {
          e.preventDefault();
          if (history.length === 0) return;
          if (historyIdx === history.length) draft = getInput();
          historyIdx = Math.max(0, historyIdx - 1);
          setInput(history[historyIdx] || "");
          return;
        }
        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (history.length === 0) return;
          historyIdx = Math.min(history.length, historyIdx + 1);
          setInput(historyIdx === history.length ? draft : history[historyIdx]);
          return;
        }
        if (e.key === "Tab") {
          e.preventDefault();
          if (claudeMode || codexMode) return;
          const cur = getInput();
          const parts = cur.split(" ");
          const last = parts[parts.length - 1];
          if (parts.length === 1) {
            const cmdMatches = Object.keys(activeNames).filter((c) => c.startsWith(last));
            // On Windows, typing a filename runs it (PATHEXT) — include cwd files as completion candidates too.
            let fileMatches = [];
            if (flavor === "windows") {
              const dir = resolve(cwd);
              if (dir && dir.type === "dir") {
                fileMatches = Object.keys(dir.children).filter((n) => n.startsWith(last));
              }
            }
            const matches = [...new Set([...cmdMatches, ...fileMatches])];
            if (matches.length === 1) {
              const only = matches[0];
              const isFile = fileMatches.includes(only) && !cmdMatches.includes(only);
              setInput(only + (isFile ? "" : " "));
            } else if (matches.length > 1) appendOutput(matches.join("  "));
          } else {
            const dir = resolve(cwd);
            if (dir && dir.type === "dir") {
              const matches = Object.keys(dir.children).filter((n) => n.startsWith(last));
              if (matches.length === 1) {
                parts[parts.length - 1] = matches[0];
                setInput(parts.join(" "));
              } else if (matches.length > 1) appendOutput(matches.join("  "));
            }
          }
          return;
        }
      };
      // Capture phase on window so we run before bubble-phase listeners
      // and most document-level capture listeners. Also block keypress so
      // older plugins relying on it can't fire.
      window.addEventListener("keydown", termKeydown, true);
      // Shield typing from extensions that listen on keypress, but do NOT
      // preventDefault — that would block the hidden <input> from receiving
      // the character (and break typing entirely).
      window.addEventListener("keypress", (e) => {
        if (isTermFocused() && isOurKey(e)) e.stopImmediatePropagation();
      }, true);
      // Some plugins listen on `keyup` for Backspace; swallow it too while focused.
      window.addEventListener("keyup", (e) => {
        if (isTermFocused() && isOurKey(e)) e.stopImmediatePropagation();
      }, true);

      // Command flavor follows the shell skin: Windows skin → windows commands, everything else → unix.
      applyFlavor(wrap && wrap.dataset.os === "windows" ? "windows" : "unix");
      appendWelcome();
      appendOutput("");
      focusTerm();

      // Fetch the post-build receipt; populate ~/receipt.txt's content once
      // it arrives. Silent failure in dev (where /receipt.txt may 404).
      fetch("/receipt.txt", { cache: "no-store" })
        .then((r) => (r.ok ? r.text() : null))
        .then((t) => { if (t) RECEIPT_HOLDER.text = t; })
        .catch(() => {});
    })();
  </script>
