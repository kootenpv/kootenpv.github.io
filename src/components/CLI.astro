      function shortPath(p) {
        if (p === HOME) return "~";
        if (p.startsWith(HOME + "/")) return "~" + p.slice(HOME.length);
        return p;
      }
      function winPath(p) {
        // Map our internal unix path to a Windows-looking display path.
        // /home/guest -> C:\Users\guest, then swap separators.
        let s = p;
        if (s === HOME) s = "C:\\Users\\guest";
        else if (s.startsWith(HOME + "/")) s = "C:\\Users\\guest" + s.slice(HOME.length);
        else if (s === "/") s = "C:\\";
        else s = "C:" + s;
        return s.replace(/\//g, "\\");
      }
      function renderPrompt() {
        if (claudeMode || codexMode) {
          promptEl.textContent = "❯ ";
          return;
        }
        const f = flavorCfg();
        const tpl = f.promptTemplate || "{user}@{host}:{cwd}$ ";
        const cwdShown = flavor === "windows" ? winPath(cwd) : shortPath(cwd);
        promptEl.textContent = tpl
          .replace("{user}", f.user || "guest")
          .replace("{host}", f.host || "vks.ai")
          .replace("{cwd}", cwdShown);
      }
      function normalize(path) {
        let abs;
        if (path.startsWith("/")) abs = path;
        else if (path === "~" || path.startsWith("~/")) abs = HOME + path.slice(1);
        else abs = cwd + "/" + path;
        const parts = abs.split("/").filter(Boolean);
        const stack = [];
        for (const p of parts) {
          if (p === ".") continue;
          if (p === "..") stack.pop();
          else stack.push(p);
        }
        return "/" + stack.join("/");
      }
      function matchesScope(scope, current) {
        if (Array.isArray(scope)) return scope.includes(current);
        return scope === current;
      }
      function flavorAllows(node, currentFlavor) {
        if (node.flavor && !matchesScope(node.flavor, currentFlavor)) return false;
        if (node.skin) {
          const currentSkin = (wrap && wrap.dataset.os) || "";
          if (!matchesScope(node.skin, currentSkin)) return false;
        }
        return true;
      }
      function resolve(path) {
        const abs = normalize(path);
        if (abs === "/") return ROOT;
        const parts = abs.split("/").filter(Boolean);
        let node = ROOT;
        for (const p of parts) {
          if (node.type !== "dir") return null;
          const child = node.children[p];
          if (!child) return null;
          // Hide nodes scoped to a different flavor.
          if (!flavorAllows(child, flavor)) return null;
          node = child;
        }
        return node;
      }
      function read(node) {
        if (typeof node.getContent === "function") return node.getContent();
        return node.content || "";
      }
      function fileSize(node) {
        return read(node).length;
      }
      function appendOutput(text, cls) {
        const div = document.createElement("div");
        div.className = "term-out-line" + (cls ? " " + cls : "");
        div.textContent = text;
        outputEl.appendChild(div);
      }
      function appendHTML(html) {
        const div = document.createElement("div");
        div.className = "term-out-line";
        div.innerHTML = html;
        outputEl.appendChild(div);
      }
      function appendWelcome() {
        const welcome = flavorCfg().welcome || "";
        const marker = "`help`";
        const idx = welcome.indexOf(marker);
        if (idx === -1) {
          appendOutput(welcome);
          return;
        }
        appendHTML(
          escapeHTML(welcome.slice(0, idx)) +
          commandButtonHTML("help", "help", "term-link") +
          escapeHTML(welcome.slice(idx + marker.length))
        );
      }
      function escapeHTML(s) {
        return s.replace(/[&<>"']/g, (c) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        })[c]);
      }
      function isMobileMode() {
        return window.matchMedia("(max-width: 640px), (pointer: coarse)").matches;
      }
      function commandButtonHTML(label, command, cls) {
        return '<button type="button" class="' + (cls ? cls + " " : "") + 'term-run-link" ' +
          'data-run-command="' + escapeHTML(command) + '">' + escapeHTML(label) + "</button>";
      }
      function shellQuote(s) {
        if (/^[A-Za-z0-9_./~:-]+$/.test(s)) return s;
        return "'" + s.replace(/'/g, "'\\''") + "'";
      }
      function joinPath(base, name) {
        return (base === "/" ? "" : base) + "/" + name;
      }
      function relativeToCwd(abs) {
        if (abs === cwd) return ".";
        if (abs.startsWith(cwd + "/")) return abs.slice(cwd.length + 1);
        return abs;
      }
      function parseArgs(argv) {
        const opts = {}; const positional = [];
        for (let i = 0; i < argv.length; i++) {
          const a = argv[i];
          if (a.startsWith("--") && a.length > 2) {
            opts[a.slice(2)] = true;
          } else if (a.startsWith("-") && a.length > 1) {
            const key = a.slice(1);
            if (/^n\d+$/.test(key)) opts.n = parseInt(key.slice(1), 10);
            else if (key === "n" && i + 1 < argv.length) opts.n = parseInt(argv[++i], 10);
            else {
              // Split combined short flags: -lhtr -> -l -h -t -r
              for (const ch of key) opts[ch] = true;
            }
          } else positional.push(a);
        }
        return { opts, positional };
      }
      function humanSize(n) {
        if (n < 1024) return n + "B";
        if (n < 1024 * 1024) return (n / 1024).toFixed(1) + "K";
        if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + "M";
        return (n / 1024 / 1024 / 1024).toFixed(1) + "G";
      }
      const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
      function fmtMtime(d) {
        if (!(d instanceof Date)) d = new Date();
        const mo = MONTHS[d.getMonth()];
        const day = String(d.getDate()).padStart(2, " ");
        const hh = String(d.getHours()).padStart(2, "0");
        const mm = String(d.getMinutes()).padStart(2, "0");
        return mo + " " + day + " " + hh + ":" + mm;
      }

      // ---------- Flavor / commands data ----------
