---
import commandsData from "~/data/commands.json";
import { getPublishedPosts, postUrl } from "~/lib/posts";
import { buildLlmsTxt } from "~/lib/llms";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const ICONS: Record<string, string> = {
  macos:
    "M19.665 16.811a10.316 10.316 0 01-1.021 1.837c-.537.767-.978 1.297-1.316 1.592-.525.482-1.089.73-1.692.744-.432 0-.954-.123-1.562-.373-.61-.249-1.17-.371-1.683-.371-.537 0-1.113.122-1.73.371-.616.25-1.114.381-1.495.393-.577.025-1.154-.229-1.729-.764-.367-.32-.826-.87-1.377-1.648-.59-.829-1.075-1.794-1.455-2.891-.407-1.187-.611-2.335-.611-3.447 0-1.273.275-2.372.826-3.292a4.857 4.857 0 011.73-1.751 4.65 4.65 0 012.34-.662c.46 0 1.063.142 1.81.422s1.227.422 1.436.422c.158 0 .689-.167 1.593-.498.853-.307 1.573-.434 2.163-.384 1.6.129 2.801.759 3.6 1.895-1.43.867-2.137 2.08-2.123 3.637.012 1.213.453 2.222 1.317 3.023a4.33 4.33 0 001.315.863c-.106.307-.218.6-.336.882zM15.998 2.38c0 .95-.348 1.838-1.039 2.659-.836.976-1.846 1.541-2.941 1.452a2.955 2.955 0 01-.021-.36c0-.913.396-1.889 1.103-2.688.352-.404.8-.741 1.343-1.009.542-.264 1.054-.41 1.536-.435.013.128.019.255.019.381z",
  windows:
    "M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.899",
  linux:
    "M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.21.629-.475.649-.829.023-.354-.207-.72-.703-1.117v-.003c-.225-.18-.408-.51-.762-.91s-.831-.94-1.604-1.32a3.6 3.6 0 00-.625-2.84c-.515-.778-1.292-1.466-2.21-2.024-1.034-.624-2.135-1.197-3.043-1.957-.873-.745-1.578-1.59-1.926-2.495-.247-.692-.347-1.514-.382-2.32-.034-.806.001-1.587.001-2.196 0-1.65-.456-2.96-1.07-3.84-.74-1.06-1.715-1.477-2.824-1.477z",
  ios:
    "M17.5 14.5c-.5 0-1.5.6-2.4.6-.95 0-1.83-.55-2.45-.55-.62 0-1.5.55-2.45.55-.92 0-1.86-.62-2.4-.62-1.65 0-3.3 2.65-3.3 4.95 0 1.5.5 2.6 1.4 2.6.95 0 1.5-.5 2.7-.5s1.65.5 2.65.5c1 0 1.45-.5 2.65-.5s1.7.5 2.7.5c.9 0 1.4-1.1 1.4-2.6 0-2.3-1.65-4.95-3.3-4.95zM12 12c1.7 0 3.05-1.65 3.05-3.4 0-.05 0-.15-.02-.25-1.43.05-3.05 1.6-3.05 3.4 0 .05 0 .15.02.25z",
  android:
    "M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 00-.83.22l-1.88 3.24c-2.86-1.21-6.08-1.21-8.94 0L5.65 5.67a.643.643 0 00-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48C3.3 11.25 1.28 14.44 1 18h22c-.28-3.56-2.3-6.75-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z",
};

const osVariants = [
  { id: "macos", label: "macOS" },
  { id: "windows", label: "Windows" },
  { id: "linux", label: "Linux" },
  { id: "ios", label: "iOS" },
  { id: "android", label: "Android" },
];

// Raw markdown sources for ~/blog. We use Vite's ?raw so the original .md
// (frontmatter included) is preserved verbatim, even though Astro also
// renders these files into HTML pages elsewhere.
const rawPosts = import.meta.glob("../content/posts/*.{md,mdx}", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const publishedPosts = await getPublishedPosts();
const urlById = new Map(publishedPosts.map((e) => [e.id, postUrl(e)]));
const blogPosts = Object.entries(rawPosts)
  .map(([path, content]) => {
    const filename = path.split("/").pop() as string;
    // Astro 5's glob loader strips the extension from `entry.id`, so look up
    // by the bare slug. Falls back to the filename in case that ever changes.
    const idKey = filename.replace(/\.(md|mdx)$/, "");
    const url = urlById.get(idKey) || urlById.get(filename);
    if (!url) return null; // skip drafts in prod
    const m = filename.match(/^(\d{4})-(\d{2})-(\d{2})/);
    const mtime = m
      ? new Date(`${m[1]}-${m[2]}-${m[3]}T08:00:00Z`).toISOString()
      : new Date().toISOString();
    return { name: filename, content, mtime, url };
  })
  .filter((p): p is { name: string; content: string; mtime: string; url: string } => p !== null)
  .sort((a, b) => a.name.localeCompare(b.name));

const llmsTxt = await buildLlmsTxt();

// Raw markdown of the agent prompt files — exposed in the virtual ~/ so
// users can `cat AGENTS.md` / `cat CLAUDE.md` to see the rules behind
// the gag. Read via fs at build time; a bare `.md` import would otherwise
// be routed through Astro's markdown pipeline.
const codexSystemPrompt = readFileSync(
  fileURLToPath(new URL("../../AGENTS.md", import.meta.url)),
  "utf8"
);
const claudeSystemPrompt = readFileSync(
  fileURLToPath(new URL("../../CLAUDE.md", import.meta.url)),
  "utf8"
);
---

<script is:inline>
    // Tell Grammarly / LanguageTool / similar overlays to skip this page —
    // the terminal is not prose and the overlays interfere with caret/cursor
    // logic and IME handling.
    (function () {
      var b = document.body;
      if (!b) return;
      b.setAttribute("data-gramm", "false");
      b.setAttribute("data-gramm_editor", "false");
      b.setAttribute("data-enable-grammarly", "false");
    })();
  </script>
  <div class="os-switcher" role="toolbar" aria-label="OS style">
    <span class="os-switcher-label">Are you ready?</span>
    <span class="os-switcher-label">// SHELL SKIN (you should try multiple!) <span class="os-switcher-hint">(autoselected for you)</span></span>
    <div class="os-switcher-grid">
      {osVariants.map((v) => (
        <button type="button" class="os-chip" data-os-set={v.id} aria-pressed="false">
          <svg class="os-chip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICONS[v.id]}></path>
          </svg>
          <span class="os-chip-label">{v.label}</span>
        </button>
      ))}
    </div>
  </div>

  <script type="application/json" id="cli-commands-data" set:html={JSON.stringify(commandsData).replace(/<\/script/gi, "<\\/script")}></script>
  {/* Posts can legitimately contain `</script>` in code blocks; without this
      escape the browser closes the JSON tag early and dumps the rest of the
      markdown into the visible page. `<\/` is a valid JSON escape for `</`. */}
  <script type="application/json" id="cli-blog-data" set:html={JSON.stringify(blogPosts).replace(/<\/script/gi, "<\\/script")}></script>
  <script type="application/json" id="cli-llms-data" set:html={JSON.stringify({ llms: llmsTxt }).replace(/<\/script/gi, "<\\/script")}></script>
  <script type="application/json" id="cli-codex-prompt-data" set:html={JSON.stringify({ codex: codexSystemPrompt, claude: claudeSystemPrompt }).replace(/<\/script/gi, "<\\/script")}></script>

  <div id="terminal-wrap" class="terminal-wrap" data-os="macos">
    {/* macOS chrome */}
    <div class="chrome chrome-mac">
      <div class="mac-controls">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>
      <span class="mac-title">guest@vks.ai — ~</span>
      <span class="mac-spacer"></span>
    </div>

    {/* Windows 11 chrome */}
    <div class="chrome chrome-win">
      <span class="win-title">
        <span class="win-icon">▶_</span>
        <span>Terminal — guest@vks.ai</span>
      </span>
      <span class="win-controls">
        <button type="button" class="win-btn" aria-label="Minimize">&#xE921;</button>
        <button type="button" class="win-btn" aria-label="Maximize">&#xE922;</button>
        <button type="button" class="win-btn win-close" aria-label="Close">&#xE8BB;</button>
      </span>
    </div>

    {/* Linux (GNOME) chrome */}
    <div class="chrome chrome-linux">
      <span class="linux-title">guest@vks.ai: ~</span>
      <span class="linux-controls">
        <button type="button" class="linux-btn" aria-label="Minimize">−</button>
        <button type="button" class="linux-btn" aria-label="Maximize">▢</button>
        <button type="button" class="linux-btn linux-close" aria-label="Close">×</button>
      </span>
    </div>

    {/* iOS chrome */}
    <div class="chrome chrome-ios">
      <div class="ios-status">
        <span class="ios-time">9:41</span>
        <span class="ios-notch"></span>
        <span class="ios-icons">
          <span class="ios-signal"><i></i><i></i><i></i><i></i></span>
          <span class="ios-wifi">􀙇</span>
          <span class="ios-battery"></span>
        </span>
      </div>
      <div class="ios-navbar">
        <span class="ios-back">‹ Back</span>
        <span class="ios-navtitle">Terminal</span>
        <span class="ios-action">⋯</span>
      </div>
    </div>

    {/* Android chrome */}
    <div class="chrome chrome-android">
      <div class="android-status">
        <span class="android-time">9:41</span>
        <span class="android-icons">
          <span>▴</span>
          <span class="android-wifi">▼</span>
          <span class="android-battery"></span>
        </span>
      </div>
      <div class="android-appbar">
        <span class="android-menu">≡</span>
        <span class="android-title">Terminal</span>
        <span class="android-overflow">⋮</span>
      </div>
    </div>

    <div id="term" class="terminal" tabindex="0">
      <div id="term-output"></div>
      <div class="term-line">
        <span id="term-prompt" class="term-prompt"></span>
        <span class="term-input-wrap">
          <span id="term-input" class="term-input"></span><span class="term-cursor">█</span>
        </span>
        {/* Hidden real <input> overlaid on the line — exists solely so mobile
            browsers raise the on-screen keyboard when the terminal is focused.
            Visually transparent; the visible "input" is still the span above,
            mirrored from this element on every `input` event. */}
        <input
          id="term-mobile-input"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          aria-hidden="true"
          data-gramm="false"
          data-gramm_editor="false"
          data-enable-grammarly="false"
        />
      </div>
    </div>
  </div>

  <style is:global>
    /* ---------- OS switcher (tron-ares) ---------- */
    .os-switcher {
      position: relative;
      margin-bottom: 14px;
      padding: 14px 16px;
      border: 1px solid rgb(var(--c-accent) / 0.55);
      border-radius: 6px;
      background:
        linear-gradient(135deg, rgb(var(--c-accent) / 0.06), rgb(var(--c-bg) / 0)),
        rgb(0 0 0 / 0.55);
      box-shadow:
        0 0 0 1px rgb(var(--c-accent) / 0.15),
        0 0 18px rgb(var(--tron-glow, 255 90 50) / 0.25),
        inset 0 0 24px rgb(var(--tron-glow, 255 90 50) / 0.05);
      backdrop-filter: blur(2px);
    }
    .os-switcher::before,
    .os-switcher::after {
      content: "";
      position: absolute;
      width: 14px; height: 14px;
      border: 1px solid rgb(var(--c-accent));
      box-shadow: 0 0 8px rgb(var(--tron-glow, 255 90 50) / 0.7);
    }
    .os-switcher::before {
      top: -1px; left: -1px;
      border-right: 0; border-bottom: 0;
    }
    .os-switcher::after {
      bottom: -1px; right: -1px;
      border-left: 0; border-top: 0;
    }
    .os-switcher-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.2em;
      color: rgb(var(--c-accent));
      text-shadow: 0 0 8px rgb(var(--tron-glow, 255 90 50) / 0.6);
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    .os-switcher-hint {
      color: rgb(var(--c-muted));
      letter-spacing: 0.12em;
      text-shadow: none;
      font-weight: 400;
      margin-left: 6px;
    }
    .os-switcher-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 8px;
    }
    .os-chip {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      justify-content: center;
      padding: 10px 12px;
      border: 1px solid rgb(var(--c-accent) / 0.4);
      background: rgb(0 0 0 / 0.6);
      color: rgb(var(--c-fg));
      font: inherit;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform 0.12s ease, background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      overflow: hidden;
    }
    .os-chip::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent 35%, rgb(var(--c-accent) / 0.18) 50%, transparent 65%);
      transform: translateX(-100%);
      transition: transform 0.45s ease;
      pointer-events: none;
    }
    .os-chip:hover::before { transform: translateX(100%); }
    .os-chip:hover {
      border-color: rgb(var(--c-accent));
      color: rgb(var(--c-accent));
      box-shadow:
        0 0 0 1px rgb(var(--c-accent) / 0.25),
        0 0 14px rgb(var(--tron-glow, 255 90 50) / 0.45);
      transform: translateY(-1px);
    }
    .os-chip-icon {
      width: 18px;
      height: 18px;
      flex: none;
      filter: drop-shadow(0 0 4px rgb(var(--tron-glow, 255 90 50) / 0.4));
    }
    .os-chip-label { white-space: nowrap; }
    .os-chip[aria-pressed="true"] {
      border-color: rgb(var(--c-accent));
      color: rgb(var(--c-bg));
      background:
        linear-gradient(135deg, rgb(var(--c-accent)) 0%, rgb(var(--tron-glow, 255 90 50)) 100%);
      box-shadow:
        0 0 0 1px rgb(var(--c-accent)),
        0 0 18px rgb(var(--tron-glow, 255 90 50) / 0.7),
        inset 0 0 12px rgb(0 0 0 / 0.25);
      text-shadow: 0 0 6px rgb(0 0 0 / 0.3);
    }
    .os-chip[aria-pressed="true"] .os-chip-icon {
      filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.4));
    }

    /* ---------- Terminal shell ---------- */
    .terminal-wrap {
      border: 1px solid rgb(var(--c-border));
      overflow: hidden;
      background: #000;
      font-family: var(--font-mono);
      box-shadow: 0 0 24px rgb(var(--tron-glow, 255 90 50) / 0.18);
    }

    /* hide every chrome by default; show the active one */
    .chrome { display: none; }
    [data-os="macos"]   .chrome-mac     { display: flex; }
    [data-os="windows"] .chrome-win     { display: flex; }
    [data-os="linux"]   .chrome-linux   { display: flex; }
    [data-os="ios"]     .chrome-ios     { display: block; }
    [data-os="android"] .chrome-android { display: block; }

    .terminal {
      height: 60vh;
      padding: 12px 14px;
      overflow-y: auto;
      color: #e0e0e0;
      font-size: 14px;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-word;
      cursor: text;
      outline: none;
      background: #000;
      user-select: text;
      -webkit-user-select: text;
    }
    .terminal * {
      user-select: text;
      -webkit-user-select: text;
    }
    .term-line { display: flex; flex-wrap: wrap; position: relative; }
    /* Hidden mobile-keyboard probe: covers the prompt line so iOS doesn't
       try to scroll a tiny sliver into view, but is fully transparent and
       click-through. Pointer events are off so taps still hit the terminal
       (which programmatically focuses this input on click). 16px font-size
       prevents iOS from auto-zooming when the field gets focus. */
    #term-mobile-input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: transparent;
      caret-color: transparent;
      font-size: 16px;
      pointer-events: none;
      user-select: none;
      -webkit-user-select: none;
    }
    /* Claude REPL framing: faint horizontal rules above and below the live
     * input, mirroring the real Claude Code chrome. Only the live input —
     * historical echoed lines stay plain. */
    [data-claude-mode="true"] .term-line,
    [data-codex-mode="true"] .term-line {
      margin: 8px 0;
      padding: 6px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.32);
      border-bottom: 1px solid rgba(255, 255, 255, 0.32);
    }
    /* Codex banner: a static Unicode box with the model + cwd lines, same
     * structure as Claude's banner just with OpenAI Codex chrome. */
    .codex-banner {
      display: block;
      white-space: pre;
      font-family: var(--font-mono);
      line-height: 1.2;
    }
    .codex-banner-frame { color: #10a37f; }
    .codex-banner-title { color: #10a37f; font-weight: 600; }
    .codex-banner-tip {
      color: rgb(var(--c-muted));
      margin-top: 4px;
      white-space: pre;
    }
    .codex-model-picker {
      display: inline-block;
      border: 1px solid #10a37f;
      border-radius: 6px;
      padding: 6px 8px;
      margin: 4px 0;
      background: rgba(16, 163, 127, 0.06);
      font-family: var(--font-mono);
      min-width: 240px;
    }
    .codex-model-picker-title {
      color: #10a37f;
      font-weight: 600;
      margin-bottom: 4px;
      font-size: 0.92em;
    }
    .codex-model-option {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      background: transparent;
      border: none;
      padding: 4px 6px;
      border-radius: 4px;
      color: inherit;
      font: inherit;
      cursor: pointer;
      text-align: left;
    }
    .codex-model-option:hover,
    .codex-model-option:focus-visible {
      background: rgba(16, 163, 127, 0.18);
      outline: none;
    }
    .codex-model-picker[data-active="true"] .codex-model-option {
      background: rgba(16, 163, 127, 0.28);
      box-shadow: inset 0 0 0 1px #10a37f;
    }
    .codex-model-picker[data-active="true"] .codex-model-option-marker {
      animation: codex-model-blink 1s steps(2, start) infinite;
    }
    @keyframes codex-model-blink {
      to { visibility: hidden; }
    }
    .terminal.model-picker-active .term-cursor { visibility: hidden; }
    .terminal.model-picker-active .term-input-wrap { opacity: 0.4; }
    .codex-model-option-marker { color: #10a37f; }
    .codex-model-option-badge {
      margin-left: auto;
      font-size: 0.78em;
      color: rgb(var(--c-muted));
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .codex-model-confirm { color: #10a37f; }
    /* The /login URL: visibly underlined but not a real link — not clickable. */
    .claude-fake-link {
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: text;
    }
    .term-prompt {
      color: rgb(var(--c-accent, 80 250 123));
      white-space: pre;
      margin-right: 6px;
    }
    .term-input-wrap { display: inline-flex; align-items: center; flex: 1; min-width: 0; }
    .term-input { white-space: pre-wrap; word-break: break-word; }
    .term-cursor {
      display: inline-block;
      margin-left: 1px;
      color: rgb(var(--c-accent, 80 250 123));
      transform: scaleX(0.18);
      transform-origin: left center;
      animation: none;
    }
    .terminal:focus-within .term-cursor {
      transform: scaleX(1);
      animation: blink 1s steps(2, start) infinite;
    }
    @keyframes blink { to { visibility: hidden; } }
    .term-out-line { white-space: pre-wrap; }
    .claude-banner-m { display: none; }
    .claude-banner {
      --claude-banner-line: 1.16em;
      --claude-cell-x: 0.78ch;
      display: flex;
      align-items: flex-start;
      gap: 1.5ch;
      line-height: var(--claude-banner-line);
    }
    .claude-mascot {
      display: inline-grid;
      grid-template-columns: repeat(18, calc(var(--claude-cell-x) / 2));
      grid-template-rows: repeat(6, calc(var(--claude-banner-line) / 2));
      flex: 0 0 calc(9 * var(--claude-cell-x));
      width: calc(9 * var(--claude-cell-x));
      height: calc(3 * var(--claude-banner-line));
    }
    .claude-pixel {
      display: block;
      width: calc(100% + 0.75px);
      height: calc(100% + 0.75px);
      background: #ff3b30;
    }
    .claude-banner-text {
      flex: 1;
      min-width: 0;
    }
    .claude-banner-text > div {
      line-height: var(--claude-banner-line);
