---
import BaseLayout from "./BaseLayout.astro";
import Giscus from "~/components/Giscus.astro";
import { SITE } from "~/config";
import type { Post } from "~/lib/posts";
import { readingTime } from "~/lib/posts";

interface Props {
  entry: Post;
  body: string;
}

const { entry, body } = Astro.props;
const { title, subtitle, description, date, updated, tags, comments, image } = entry.data;
const minutes = readingTime(body);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description ?? subtitle ?? SITE.description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.url,
  },
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).toString(),
  ...(image && { image: new URL(image, SITE.url).toString() }),
};

const dateFmt = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: SITE.timezone,
});
---

<BaseLayout
  title={title}
  description={description ?? subtitle}
  image={image}
  type="article"
  date={date}
  updated={updated}
  jsonLd={jsonLd}
>
  <article class="prose max-w-none prose-headings:scroll-mt-20">
    <header class="not-prose mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold text-fg">{title}</h1>
      {subtitle && <p class="mt-2 text-lg text-muted">{subtitle}</p>}
      <div class="mt-3 text-sm text-muted flex flex-wrap items-center gap-3">
        <time datetime={date.toISOString()}>{dateFmt}</time>
        <span>· {minutes} min read</span>
        {
          tags.length > 0 && (
            <span class="flex flex-wrap gap-1">
              {tags.map((t) => (
                <a class="text-accent" href={`/tags/${t}`}>
                  #{t}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </header>
    <slot />
  </article>
  {comments !== false && <Giscus />}
</BaseLayout>
